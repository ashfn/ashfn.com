{
  "name": "ashfn-static",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx scripts/serve.mjs --watch",
    "build": "node --import tsx node_modules/@11ty/eleventy/cmd.cjs",
    "preview": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "node tests/verify.mjs",
    "test:browser": "node tests/interactions.mjs",
    "measure": "node tests/measure.mjs",
    "test:nojs": "node tests/nojs.mjs",
    "test:safest": "node tests/safest.mjs",
    "test:editor": "node tests/editor.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@mdx-js/mdx": "3.1.1",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "20.19.27",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/react-syntax-highlighter": "15.5.13",
    "cheerio": "^1.1.2",
    "esbuild": "^0.25.0",
    "gray-matter": "4.0.3",
    "katex": "0.16.27",
    "lucide-react": "0.562.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0",
    "postcss": "8.5.28",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "5.5.0",
    "react-markdown": "10.1.0",
    "react-syntax-highlighter": "16.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "tailwindcss": "4.1.18",
    "tsx": "^4.20.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
